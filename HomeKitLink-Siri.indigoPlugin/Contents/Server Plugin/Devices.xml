<?xml version="1.0"?>
<Devices>

	<Device type="custom" id="homeKitBridgeDevice">
		<Name>HomeKitLink-Siri Bridge</Name>
		<ConfigUI>
			<Field id="deviceIdlabel" type="label" fontColor="blue" fontSize="large" >
				<Label>Select the device you wish to publish (or edit) to HomeKit.</Label>
			</Field>
			<Field id="selectdevice_or_AG" type="menu" defaultValue="device" >
				<Label>Select Type to List:</Label>
        	 <List>
                	<Option value="device">all Indigo Devices</Option>
                    <Option value="action_group">Indigo Action Groups</Option>
				 	<Option value="lights">Indigo Lights</Option>
				    <Option value="switch">Indigo Relay Devices</Option>
				    <Option value="sensor">Indigo Sensor Devices</Option>
				    <Option value="thermostat">Indigo Thermostats</Option>
				    <Option value="fan">Indigo Fans (Speed Control)</Option>
				    <Option value="sprinkler">Indigo Sprinklers</Option>
				    <Option value="plugin">Plugin Devices (grouped by plugin)</Option>
				    <Option value="cameras">Cameras (all)</Option>
				    <Option value="BI_camera">Blue Iris Camera</Option>
				 	<Option value="SS_camera">Security Spy Camera</Option>
				 	<Option value="UP_camera">UniFi Protect Camera</Option>
				 	<Option value="hk_buttons">HomeKitLink Buttons and Sensors</Option>
                </List>
				  <CallbackMethod>menuChanged</CallbackMethod>
			</Field>
			<Field id="listSearch" type="textfield" defaultValue="">
				<Label>Search:</Label>
			</Field>
			<Field id="listSearchApplied" type="textfield" hidden="true" defaultValue="">
				<Label/>
			</Field>
			<Field id="listSearchFind" type="button">
				<Label/>
				<Title>Find</Title>
				<CallbackMethod>list_search</CallbackMethod>
			</Field>
			<Field id="listSearchClear" type="button">
				<Label/>
				<Title>Clear</Title>
				<CallbackMethod>list_search_clear</CallbackMethod>
			</Field>
			<Field id="listSearchLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true">
				<Label>Type part of a name (or several words, in any order) and press Find to list only matching devices; Clear lists them all again. Use Find rather than Return (Return is the dialog's Save).</Label>
			</Field>
			<Field id="deviceId" type="menu" defaultValue="">
				<Label>Device to Publish:</Label>
				<List class="self" method="device_list_generator" dynamicReload="true"/>
				<CallbackMethod>select_device</CallbackMethod>
			</Field>
			<Field type="checkbox" id="isDeviceSelected" defaultValue="false" hidden="true">
				<Label/>
				<Description/>
			</Field>

			<Field type="textfield" id="bridgeUniqueID" hidden="true">
				<Label/>
				<Description/>
			</Field>

			<Field id="sep1" type="separator"/>

			<Field type="checkbox" id="HomeKit_publishDevice_2" defaultValue="false" enabledBindingId="isDeviceSelected" visibleBindingId="isDeviceSelected" visibleBindingValue="true">
				<Label>Publish device:</Label>
				<Description>Make this device available to HomeKit           </Description>
				<CallbackMethod>toggle_publish</CallbackMethod>
			</Field>
			<Field id="publishDeviceLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="showSubtypes" visibleBindingValue="true">
				<Label>Please enable this checkBox for Device to be accessible within HomeKit.</Label>
			</Field>
			<Field type="checkbox" id="showSubtypes" defaultValue="true" hidden="true">
				<Label/>
				<Description/>
			</Field>

			<Field id="altName" type="textfield" enabledBindingId="HomeKit_publishDevice_2" defaultValue="false" visibleBindingId="isDeviceSelected" visibleBindingValue="true">
				<Label>HomeKit Device name:</Label>
			</Field>
			<Field id="altNameLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" visibleBindingId="isDeviceSelected" visibleBindingValue="true">
				<Label>This is the HomeKit Name of the Device.</Label>
			</Field>

			<Field id="deviceSubtype" type="menu" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="showSubtypes" visibleBindingValue="true">
				<Label>HomeKit Device Type:</Label>
				<List class="self" method="subtype_generator" dynamicReload="true"/>
				<CallbackMethod>subtype_callback</CallbackMethod>
			</Field>


			<Field id="deviceSubtypeLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="showSubtypes" visibleBindingValue="true">
				<Label>Select an available HomeKit Device Type. Try Show All Options if the correct option doesn't auto-select	</Label>
			</Field>

			<Field id="deviceSubtype_LightInfo" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="LightBulb">
				<Label>LightBulb - This really refers to 3 devices within HomeKit.
1. Simple switch on/off which is a bulb, this can be changed in app to any other switch icon.
2. Dimmable Bulb with brightness control
3. Dimmable Bulb with RGB color support.
The plugin will decide which is possible aiming for 3, then 2, then 1.  If a simple switch is wanted regardless, select LightBulb_switch.
				</Label>
			</Field>

			<Field id="tempSelector" type="checkbox" tooltip="Enabling will select Fahrenheit." enabledBindingId="HomeKit_publishDevice_2" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="Thermostat,TemperatureSensor,HeaterCooler">
				<Label/>
				<Description>Enable to Select Fahrenheit</Description>
			</Field>
			<Field id="tempSelectorlabel" type="label"  fontSize="small" enabledBindingId="HomeKit_publishDevice_2" alignWithControl="true" visibleBindingId="deviceSubtype" visibleBindingValue="Thermostat,TemperatureSensor,HeaterCooler" alwaysUseInDialogHeightCalc="true">
				<Label>Unchecked = Celsius, enable to select Fahrenheit.</Label>
			</Field>
			<Field id="heatOnly" type="checkbox" defaultValue="false" enabledBindingId="HomeKit_publishDevice_2" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="Thermostat">
				<Label/>
				<Description>Heat only</Description>
			</Field>
			<Field id="heatOnlyLabel" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="Thermostat">
				<Label>For thermostats that only heat (e.g. floor heating): the Home app offers only Off and Heat, with no Auto range, so asking Siri to change the temperature just changes the target. Ticked already for thermostats that have no cool setpoint.</Label>
			</Field>
			<Field id="motionEnabled" type="checkbox" tooltip="Enabling will enable camera motion." enabledBindingId="HomeKit_publishDevice_2" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="BlueIrisCamera,SecuritySpyCamera,UniFiProtectCamera">
				<Label/>
				<Description>Motion Sensor Enabled</Description>
			</Field>
			<Field id="motionEnabledlabel" type="label"  fontSize="small" enabledBindingId="HomeKit_publishDevice_2" alignWithControl="true" visibleBindingId="deviceSubtype" visibleBindingValue="BlueIrisCamera,SecuritySpyCamera,UniFiProtectCamera" alwaysUseInDialogHeightCalc="true">
				<Label>Enabled = use camera motion reports to trigger in HomeKit.
Uncheck no motion sensor except through Action Group trigger.</Label>
			</Field>
			<Field id="inverseSelector" type="checkbox" tooltip="Enabling will invert controls." enabledBindingId="HomeKit_publishDevice_2" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="Blind,Window,Door">
				<Label/>
				<Description>Enable to Invert Controls</Description>
			</Field>
			<Field id="audioSelector" defaultValue="false" type="checkbox" enabledBindingId="HomeKit_publishDevice_2" tooltip="Enabling will enable audio." alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="SecuritySpyCamera,BlueIrisCamera,UniFiProtectCamera" >
				<Label/>
				<Description>Support Audio</Description>
			</Field>
			<Field id="savelabelAudio" type="label" fontColor="orange" fontSize="small" enabledBindingId="HomeKit_publishDevice_2" alignWithControl="true" visibleBindingId="deviceSubtype" visibleBindingValue="SecuritySpyCamera,BlueIrisCamera,UniFiProtectCamera" alwaysUseInDialogHeightCalc="true">
				<Label>Audio: This may break the playback of Stream.</Label>
			</Field>

			<Field id="doorbellId" type="menu" defaultValue="-1" enabledBindingId="HomeKit_publishDevice_2" visibleBindingId="deviceSubtype" visibleBindingValue="BlueIrisCamera,SecuritySpyCamera,UniFiProtectCamera">
				<Label>DoorBell Linked:</Label>
				<List class="self" method="doorbell_list_generator" dynamicReload="true" />
			</Field>
			<Field id="doorBellLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true"  visibleBindingId="deviceSubtype" visibleBindingValue="BlueIrisCamera,SecuritySpyCamera,UniFiProtectCamera">
				<Label>Device to make a DoorBell with this camera.</Label>
			</Field>
			<Field id="unifiTwoWay" type="checkbox" defaultValue="false" enabledBindingId="HomeKit_publishDevice_2" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="UniFiProtectCamera" tooltip="Talk through the camera's speaker from the Home app.">
				<Label/>
				<Description>Two-way Audio (talk)</Description>
			</Field>
			<Field id="unifiTwoWayLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="UniFiProtectCamera">
				<Label>Talk from the Home app through doorbells and cameras with a speaker. UniFi plugin (Durosity) only; needs Support Audio on.</Label>
			</Field>
			<Field id="unifiDoorbell" type="checkbox" defaultValue="false" enabledBindingId="HomeKit_publishDevice_2" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="UniFiProtectCamera" tooltip="Make this camera a HomeKit doorbell, rung by its own doorbell button.">
				<Label/>
				<Description>Treat as a doorbell</Description>
			</Field>
			<Field id="unifiDoorbellLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="UniFiProtectCamera">
				<Label>Cameras whose model contains "Doorbell" are doorbells already. Tick this for other models with a doorbell button. Restart the bridge after changing it.</Label>
			</Field>
			<Field id="unifiStreamURL" type="textfield" defaultValue="" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="UniFiProtectCamera">
				<Label>Stream URL:</Label>
			</Field>
			<Field id="unifiStreamURLLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="UniFiProtectCamera">
				<Label>UniFi plugin (Durosity): leave blank - uses the camera's RTSP streams (run its 'Enable RTSP Streaming' action, High and Low).
uniFiAP plugin (kw123): paste the RTSPS URL from Protect (camera > Settings > Advanced > RTSP, High).
A UniFi doorbell is set up as a doorbell automatically.</Label>
			</Field>
			<Field id="buttonsPublishLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="Buttons">
				<Label>A HomeKit Buttons device: Indigo presses its buttons with the action "Press a HomeKit Button", and the Home app decides what each press does. Set its buttons and names in its own settings.</Label>
			</Field>
			<Field id="aqPM25" type="menu" defaultValue="none" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="AirQualitySensor">
				<Label>PM2.5 (µg/m³):</Label>
				<List class="self" method="air_quality_state_list" dynamicReload="true"/>
			</Field>
			<Field id="aqPM10" type="menu" defaultValue="none" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="AirQualitySensor">
				<Label>PM10 (µg/m³):</Label>
				<List class="self" method="air_quality_state_list" dynamicReload="true"/>
			</Field>
			<Field id="aqVOC" type="menu" defaultValue="none" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="AirQualitySensor">
				<Label>VOC:</Label>
				<List class="self" method="air_quality_state_list" dynamicReload="true"/>
			</Field>
			<Field id="aqNO2" type="menu" defaultValue="none" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="AirQualitySensor">
				<Label>NO2:</Label>
				<List class="self" method="air_quality_state_list" dynamicReload="true"/>
			</Field>
			<Field id="aqO3" type="menu" defaultValue="none" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="AirQualitySensor">
				<Label>Ozone:</Label>
				<List class="self" method="air_quality_state_list" dynamicReload="true"/>
			</Field>
			<Field id="aqCO2" type="menu" defaultValue="none" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="AirQualitySensor">
				<Label>CO2 (ppm):</Label>
				<List class="self" method="air_quality_state_list" dynamicReload="true"/>
			</Field>
			<Field id="aqAQI" type="menu" defaultValue="none" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="AirQualitySensor">
				<Label>Air quality index:</Label>
				<List class="self" method="air_quality_state_list" dynamicReload="true"/>
			</Field>
			<Field id="aqGasUnit" type="menu" defaultValue="ugm3" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="AirQualitySensor">
				<Label>VOC, NO2 and ozone are in:</Label>
				<List>
					<Option value="ugm3">µg/m³</Option>
					<Option value="ppb">ppb (converted for HomeKit)</Option>
				</List>
			</Field>
			<Field id="aqLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="AirQualitySensor">
				<Label>Choose the device states that hold each reading; leave the others Not used. The Home app shows the readings and an overall air quality (Excellent to Poor), the worst of them. Air quality index: US AQI, 0-500.</Label>
			</Field>
			<Field id="hcZoneOf" type="menu" defaultValue="none" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="HeaterCooler">
				<Label>Zone of:</Label>
				<List class="self" method="heater_cooler_zone_list" dynamicReload="true"/>
			</Field>
			<Field id="hcLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="HeaterCooler">
				<Label>The Home app's air conditioner tile: a power button, Heat / Cool / Auto, and heat and cool targets.
Zone of: leave as "Not a zone" for a main unit or a single AC. For a zone of a ducted system (e.g. an Actron Que zone, filled in automatically), choose its main unit: the zone's power button then only opens or closes the zone, it shows the main unit's mode, and it never changes the main unit.
Publish each zone you want in the Home app separately; each becomes its own tile.</Label>
			</Field>
			<Field id="robotStart" type="menu" defaultValue="default" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="Vacuum,LawnMower">
				<Label>Start:</Label>
				<List class="self" filter="start" method="robot_actiongroup_list" dynamicReload="true"/>
			</Field>
			<Field id="robotStop" type="menu" defaultValue="default" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="Vacuum,LawnMower">
				<Label>Stop / go home:</Label>
				<List class="self" filter="stop" method="robot_actiongroup_list" dynamicReload="true"/>
			</Field>
			<Field id="robotState" type="menu" defaultValue="default" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="Vacuum,LawnMower">
				<Label>Running when:</Label>
				<List class="self" method="robot_state_list" dynamicReload="true"/>
			</Field>
			<Field id="robotRunning" type="textfield" defaultValue="" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="Vacuum,LawnMower">
				<Label>is one of:</Label>
			</Field>
			<Field id="robotLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="deviceSubtype" visibleBindingValue="Vacuum,LawnMower">
				<Label>HomeKit has no vacuum or mower tile (Apple's are for Matter devices only), so it shows as a switch: on starts it, off sends it home. Siri: "turn on the vacuum".
Start and Stop: action groups to run, or the default: turn the device on / off.
Running when: the state that shows it's working, and its values separated by commas (e.g. cleaning, spotCleaning). The default uses the device's on/off.</Label>
			</Field>
			<Field id="deviceSensor" type="menu" enabledBindingId="HomeKit_publishDevice_2" alwaysUseInDialogHeightCalc="true" visibleBindingId="showALL" visibleBindingValue="true">
				<Label>Device State:</Label>
				<List class="self" method="devicestate_generator" dynamicReload="true"/>
			</Field>
			<Field id="deviceSensorLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="showALL" visibleBindingValue="true">
				<Label>This shows the state and == its current value to help guide the correct state to choose.

If you are selecting a Sensor select the device State to send to HomeKit.  If Temperature Sensor - device needs to be number without text C/F etc.
If incorrect, hopefully won't break bridge and update with this selector.   For many other devices, this should be BLANK without harm.
				</Label>
			</Field>
			<Field id="saveLabelSpacing" type="label" fontColor="black" fontSize="large" alignWithControl="true" visibleBindingId="isDeviceSelected" visibleBindingValue="true" alwaysUseInDialogHeightCalc="true">
				<Label>


				</Label>
			</Field>

			<Field id="save" type="button"  alignWithControl="true" fontSize="large" fontColor="red" enabledBindingId="isDeviceSelected" visibleBindingId="isDeviceSelected" visibleBindingValue="true">
				<Label>Click Here to Save: </Label>
				<Title>**        Save Device      **</Title>
				<CallbackMethod>save</CallbackMethod>
			</Field>

			<Field id="saveLabel" type="label" fontColor="black" fontSize="large" alignWithControl="true" visibleBindingId="isDeviceSelected" visibleBindingValue="true" alwaysUseInDialogHeightCalc="true">
				<Label>Click to save the publication information.</Label>
			</Field>
			<Field id="saveWarningLabel" type="label" fontColor="blue" fontSize="small" alignWithControl="true" visibleBindingId="isDeviceSelected" visibleBindingValue="true" alwaysUseInDialogHeightCalc="true">
				<Label>NB: Changes are not saved if you switch devices
or close this dialog without saving first !
Plus the Publish checkbox must be enabled if you wish device in HomeKit</Label>
			</Field>
			<Field id="deviceSubtype_warningLabel" type="label" fontColor="black" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true" visibleBindingId="HomeKit_publishDevice_2" visibleBindingValue="true">
				<Label>If changing a device type - PLEASE unpublish,
** Save Device ** Button, Save config, review in HomeKit App and then re-publish	</Label>
			</Field>

			<Field id="saveDisabledLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" visibleBindingId="isDeviceSelected" visibleBindingValue="false">
				<Label>You must first select a device.
				</Label>
			</Field>

	<Field id="sep21a1" type="separator" visibleBindingId="isDeviceSelected" visibleBindingValue="true"/>

			<Field id="showALL" type="checkbox" tooltip="Enabling will show all HomeKit device options." enabledBindingId="HomeKit_publishDevice_2" dynamicReload="true" visibleBindingId="isDeviceSelected" visibleBindingValue="true">
        <Label></Label>
        <Description>Show all Options</Description>
				<CallbackMethod>all_options_menuChanged</CallbackMethod>
    	</Field>
			<Field id="showALLWarningLabel" type="label" fontColor="orange" fontSize="small" enabledBindingId="HomeKit_publishDevice_2" alignWithControl="true" visibleBindingId="showALL" visibleBindingValue="true">
				<Label>
This will show all possible HomeKit device options for the selected Indigo Device.
This comes with some risk of making the HomeKit Bridge unreachable, if uncertain add one device at a time.
If device fails and changing device types, unpublish the device, Save Device, Save Dialog which will restart Bridge.
				</Label>
			</Field>

			<Field id="sep211a" type="separator"/>
			<Field id="qrcodeshow" type="button" fontSize="large" fontColor="red" >
				<Label>
					Show QR Code
					Bridge Accessory</Label>
				<Title> Show QR Code </Title>
				<CallbackMethod>showQRcode</CallbackMethod>
			</Field>
		<Field id="sep211ab" type="separator"/>
		</ConfigUI>

