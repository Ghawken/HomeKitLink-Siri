	<Device type="sensor" id="hkSensor">
		<Name>HomeKitLink Sensor</Name>
		<ConfigUI>
			<Field id="mirrorIntro" type="label" fontSize="small">
				<Label>Publishes one state of another Indigo device to HomeKit as a sensor of its own, with its own name, room and bridge. Use it when one device holds several readings (e.g. a weather gateway: outdoor temperature, humidity, light, rain): make one HomeKitLink Sensor per reading. Nothing is changed on the device it mirrors.</Label>
			</Field>
			<Field id="sourceDevice" type="menu" defaultValue="">
				<Label>Device to mirror:</Label>
				<List class="self" method="mirror_source_list" dynamicReload="true"/>
				<CallbackMethod>mirror_source_changed</CallbackMethod>
			</Field>
			<Field id="sourceState" type="menu" defaultValue="">
				<Label>State:</Label>
				<List class="self" method="mirror_state_list" dynamicReload="true"/>
			</Field>
			<Field id="sensorKind" type="menu" defaultValue="temperature">
				<Label>Sensor type:</Label>
				<List>
					<Option value="temperature">Temperature</Option>
					<Option value="humidity">Humidity</Option>
					<Option value="light">Light (lux)</Option>
					<Option value="-1">%%separator%%</Option>
					<Option value="contact">Contact (on = open)</Option>
					<Option value="motion">Motion</Option>
					<Option value="occupancy">Occupancy</Option>
					<Option value="leak">Leak</Option>
					<Option value="smoke">Smoke</Option>
					<Option value="co">Carbon Monoxide</Option>
					<Option value="co2">Carbon Dioxide</Option>
				</List>
			</Field>
			<Field id="mirrorFahrenheit" type="checkbox" defaultValue="false" visibleBindingId="sensorKind" visibleBindingValue="temperature">
				<Label>Temperature in:</Label>
				<Description>°F (unticked: °C)</Description>
			</Field>
			<Field id="onWhen" type="menu" defaultValue="true" visibleBindingId="sensorKind" visibleBindingValue="contact,motion,occupancy,leak,smoke,co,co2">
				<Label>Detected when the state:</Label>
				<List>
					<Option value="true">is true / on</Option>
					<Option value="false">is false / off</Option>
					<Option value="equals">equals a value</Option>
				</List>
			</Field>
			<Field id="onValue" type="textfield" defaultValue="" visibleBindingId="onWhen" visibleBindingValue="equals">
				<Label>Value:</Label>
			</Field>
			<Field id="mirrorSep" type="separator"/>
			<Field id="publishBridge" type="menu" defaultValue="none">
				<Label>Publish to bridge:</Label>
				<List class="self" method="own_bridge_list" dynamicReload="true"/>
			</Field>
			<Field id="homekitName" type="textfield" defaultValue="">
				<Label>HomeKit name:</Label>
			</Field>
			<Field id="homekitNameLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true">
				<Label>The name it's added to the Home app with (needed to publish; a suggestion is filled in if empty). Renaming the Indigo device doesn't change it. Once added, the Home app keeps its own copy of the name: rename it there too.</Label>
			</Field>
			<Field id="mirrorPublishLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true">
