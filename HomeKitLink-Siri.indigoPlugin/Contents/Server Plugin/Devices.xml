			</Field>
			<Field id="publishBridgeLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true">
				<Label>Saving restarts the bridge to add (or remove) these buttons. You can also publish it from a bridge's own settings: Select Type to List > HomeKitLink Buttons and Sensors.</Label>
			</Field>
		</ConfigUI>
