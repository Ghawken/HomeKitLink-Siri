    <MenuItem id="moveBridgeitems">
        <Name>Move Accessories to another Bridge</Name>
        <ConfigUI>
            <Field id="fromBridge" type="menu">
                <Label>From Bridge:</Label>
                <List class="self" method="bridgeListGenerator"/>
            </Field>
            <Field id="toBridge" type="menu">
                <Label>To Bridge:</Label>
                <List class="indigo.devices" filter="self.homeKitBridgeDevice"/>
            </Field>
            <Field id="moveConfirm" type="checkbox" defaultValue="false">
                <Label>Confirm:</Label>
                <Description>Move them (unticked: logs which devices would move)</Description>
            </Field>
            <Field id="internallist" type="button">
                <Label>Do:</Label>
                <Title>Move Accessories</Title>
                <CallbackMethod>menu_actionMoveAccessories</CallbackMethod>
            </Field>
			<Field id="moveLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true">
				<Label>Moves every device published to the From Bridge onto the To Bridge. From Bridge lists every bridge a published device uses, a deleted bridge too (its devices are orphaned): use this to put them back on a bridge without publishing each again. From Bridge shows how many are published to each. Press with Confirm unticked to log which devices would move first. Both bridges restart. In the Home app the moved devices are new accessories (new accessory IDs): set their rooms, names, automations and scenes again, and a camera's Recording Options. If the old bridge was deleted, remove it from the Home app too. To unpublish orphaned devices instead: Unlink any Orphaned Devices.</Label>
			</Field>
            <Field id="moveWarningLabel" type="label" fontColor="orange" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true">
				<Label>NB: This is not without some risk to both bridges.  Use with caution.</Label>
			</Field>

        </ConfigUI>
    </MenuItem>

    <MenuItem id="refreshBridgeConfig">
        <Name>Make Home Re-read a Bridge's Accessories</Name>
        <ConfigUI>
            <Field id="Bridge" type="menu">
                <Label>Bridge:</Label>
                <List class="indigo.devices" filter="self.homeKitBridgeDevice"/>
            </Field>
            <Field id="refreshButton" type="button">
                <Label>Do:</Label>
                <Title>Re-read Accessories</Title>
                <CallbackMethod>menu_actionRefreshBridgeConfig</CallbackMethod>
            </Field>
            <Field id="refreshLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true">
                <Label>Raises the bridge's configuration number, so every home hub, iPhone and iPad fetches its accessories again and drops any that are no longer published (e.g. an accessory still shown, as No Response, after it was removed). The bridge stays paired and keeps running; nothing is unpublished, and accessories keep their rooms, settings and recordings.</Label>
            </Field>
        </ConfigUI>
    </MenuItem>

    <MenuItem id="newHomeKitIdentity">
        <Name>New HomeKit Identity for a Device (emergency)</Name>
        <ConfigUI>
            <Field id="identityDevice" type="menu">
                <Label>Device:</Label>
                <List class="self" method="publishedDeviceListGenerator"/>
            </Field>
            <Field id="identityLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true">
                <Label>Gives the device a new accessory ID. Home removes the old accessory, with anything Home kept for it (e.g. a control or sensor still shown, as No Response, after it was removed, which neither unpublishing nor Make Home Re-read a Bridge's Accessories clears), and adds the device as a new accessory. Its bridge restarts; other accessories aren't affected. Its HomeKitLink settings and HKSV Recorder are kept.</Label>
            </Field>
            <Field id="identityWarning" type="label" fontColor="orange" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true">
                <Label>In the Home app it starts again, as a new accessory: set its room, name, automations, scenes, notifications and (for a camera) Recording Options again. A camera's recordings are deleted.</Label>
            </Field>
            <Field id="identityConfirm" type="checkbox" defaultValue="false">
                <Label>Confirm:</Label>
                <Description>I understand Home removes this accessory and adds it as new</Description>
            </Field>
            <Field id="identityButton" type="button">
                <Label>Do:</Label>
                <Title>Make New Identity</Title>
                <CallbackMethod>menu_actionNewIdentity</CallbackMethod>
            </Field>
        </ConfigUI>
    </MenuItem>

        <MenuItem id="resetBridge">
        <Name>Reset Accessory / Bridge</Name>
        <ConfigUI>
            <Field id="Bridge" type="menu">
                <Label>Bridge:</Label>
                <List class="indigo.devices" filter="self.homeKitBridgeDevice"/>
            </Field>
            <Field id="internallist2" type="button">
                <Label>Do:</Label>
                <Title>Reset Bridge Accessories</Title>
                <CallbackMethod>menu_actionResetAccessories</CallbackMethod>
            </Field>
			<Field id="moveLabel2" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true">
				<Label>
                    All going well, this will reset the Bridge.  Use this when you have deleted the bridge from the Home app and then wish to re-add.

                    It will reset the security keys of the bridge.  If not deleted from the Home app first will cause ... issues ....
				</Label>
			</Field>
            <Field id="moveWarningLabel2" type="label" fontColor="orange" fontSize="small" alignWithControl="true" alwaysUseInDialogHeightCalc="true">
				<Label>
                    ** You should have deleted this bridge from Home app first, or it was never successfully added **.
                    This deletes all security information for this bridge, without re-pairing (with QR code) nothing will function.
                    NB: This is not without some risk to the bridge.  Use with caution.</Label>

			</Field>

        </ConfigUI>
    </MenuItem>

</MenuItems>