<?xml version="1.0"?>
<Actions>
        <Action id="triggerHomeKitDevice">
        <Name>Notify HomeKit Device</Name>
        <CallbackMethod>action_triggerHomeKitDevice</CallbackMethod>
        <ConfigUI>
			<Field id="deviceIdlabel" type="label" fontColor="blue" fontSize="large" >
				<Label>Select the device type:</Label>
			</Field>
			<Field id="type_device" type="menu" defaultValue="camera_motion_true" >
				<Label>Select Type to List:</Label>
        	 <List>
				    <Option value="camera_motion_true">Camera Motion True</Option>
				    <Option value="camera_motion_false">Camera Motion False</Option>
				 	<Option value="camera_doorbell">Camera Doorbell Pressed</Option>
                </List>
				  <CallbackMethod>action_menuChanged</CallbackMethod>
			</Field>
			<Field id="deviceId" type="menu" defaultValue="">
				<Label>Action Home App Device:</Label>
				<List class="self" method="action_device_list_generator" dynamicReload="true"/>
			</Field>
        </ConfigUI>
    </Action>
    <Action id="pressHomeKitButton" deviceFilter="self.hkButtons">
        <Name>Press a HomeKit Button</Name>
        <CallbackMethod>action_pressHomeKitButton</CallbackMethod>
        <ConfigUI>
			<Field id="button" type="menu" defaultValue="1">
				<Label>Button:</Label>
				<List class="self" method="button_number_list" dynamicReload="true"/>
			</Field>
			<Field id="pressType" type="menu" defaultValue="0">
				<Label>Press:</Label>
				<List>
					<Option value="0">Single press</Option>
					<Option value="1">Double press</Option>
					<Option value="2">Long press</Option>
				</List>
			</Field>
			<Field id="pressLabel" type="label" fontColor="darkgray" fontSize="small" alignWithControl="true">
				<Label>Presses this button in the Home app, which runs whatever the Home app has set for this press. Nothing happens in Indigo itself.</Label>
			</Field>
        </ConfigUI>
    </Action>
</Actions>

